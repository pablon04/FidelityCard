# Copia a .env.local (frontend) y supabase/functions/.env (Edge Functions en local).
# NUNCA pongas valores reales aqui ni subas .env* al repo. Ver docs/ARCHITECTURE.md seccion 5.2.

# ---------- Frontend (publicas por diseno, prefijo VITE_) ----------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_BASE_URL=http://localhost:5173
# Turnstile: en local/staging usar las claves de prueba de Cloudflare
VITE_TURNSTILE_SITE_KEY=
# Apple Wallet aparcado (ADR D1). UX.md lo llama WALLET_APPLE_ENABLED; ver CLAUDE.md
VITE_APPLE_WALLET_ENABLED=false
VITE_APP_ENV=local

# ---------- Edge Functions (Supabase Secrets; NUNCA en el cliente ni en Vercel) ----------
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase; no se definen aqui.
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=

# Email (aparcado: sin dominio propio Resend free no envia a terceros)
EMAIL_REISSUE_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Apple Wallet (aparcado, diferido a la Fase D)
APPLE_ENABLED=false
WALLET_APPLE_ENABLED=false
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=
APPLE_ORGANIZATION_NAME=

# Google Wallet (Fase 4)
GOOGLE_WALLET_ENABLED=false
GOOGLE_ISSUER_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
